<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtHospital"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏥 Hospital"
        android:textColor="#0D47A1"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtLoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Checking location..."
        android:textColor="#546E7A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtNurse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nurse: —"
        android:textColor="#455A64"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSetLoc"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/signupbutton"
            android:text="📍 Set location"
            android:textAllCaps="false"
            android:textColor="#1976D2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFleet"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/loginbutton"
            android:text="🚑 Manage fleet"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ambulances: —"
        android:textColor="#2E7D32"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabAmb"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/loginbutton"
            android:text="Ambulances"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabActive"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/signupbutton"
            android:text="Active trips"
            android:textAllCaps="false"
            android:textColor="#1976D2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabHistory"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/signupbutton"
            android:text="History"
            android:textAllCaps="false"
            android:textColor="#1976D2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabSos"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/signupbutton"
            android:text="🆘 SOS (0)"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEmptyList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text=""
        android:textColor="#78909C"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/lvDispatch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@android:color/white" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/emergency"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#D32F2F"
        android:textStyle="bold" />
</LinearLayout>
