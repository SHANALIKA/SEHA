<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtNurseHospital"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👩‍⚕️ Nurse"
        android:textColor="#0D47A1"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtNurseInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#546E7A"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/redbutton"
        android:text="🚨  Scan patient face (emergency)"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="📋 Patient medical records (enter Patient ID or name)"
        android:textColor="#212121"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etPatient"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/edittext"
            android:hint="Patient ID or patient name"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnFindPatient"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/loginbutton"
            android:text="View records"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Track an ambulance by vehicle number"
        android:textColor="#212121"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etVehicle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/edittext"
            android:hint="Vehicle number (from the SMS)"
            android:inputType="textCapCharacters"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTrack"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/loginbutton"
            android:text="Track"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ambulances coming to my hospital"
        android:textColor="#212121"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="No ambulance is heading to your hospital right now."
        android:textColor="#78909C"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lvIncoming"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@android:color/white" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/emergency"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#D32F2F"
        android:textStyle="bold" />
</LinearLayout>
